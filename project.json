{
  "langrev": "1",
  "version": "0.1.28",
  "opt": "O2",
  "build-dir": "build",
  "output": "build",
  "dependency-search-paths": ["bmu/lib"],
  "targets": {
    "sms": {
      "type": "executable",
      "sources": ["src/**"],
      "dependencies": ["raylib6", "bmu"]
    },
    "install": {
      "type": "prepare",
      "depends-on": ["sms"],
      "exec": ["python3 install.py install"]
    },
    "uninstall": {
      "type": "prepare",
      "exec": ["python3 install.py uninstall"]
    }
  }
}
